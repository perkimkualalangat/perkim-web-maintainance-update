# PERKIM Web Maintenance Dashboard - Environment Configuration
# Copy this file to .env.local and fill in your values

# ==========================================
# PATHS (Required)
# ==========================================
# Absolute or relative path to the perkim-web project to manage
PERKIM_WEB_PATH=../perkim-web

# Absolute or relative path to the perkim-monitor project for audit/deploy
PERKIM_MONITOR_PATH=../perkim-monitor

# ==========================================
# NVIDIA API (Required for AI features)
# ==========================================
# Get your free API key from https://build.nvidia.com
# Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=your-nvidia-api-key-here

# Optional: Custom NVIDIA endpoint (default: https://integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Model to use (default: nvidia/nemotron-3-ultra-550b-a55b)
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: Request timeout in ms (default: 180000)
# NVIDIA_TIMEOUT_MS=180000

# ==========================================
# SERVER CONFIG
# ==========================================
# Server port (default: 5174)
PORT=5174

# Server host (default: 127.0.0.1)
HOST=127.0.0.1

# Allowed CORS origin for Vite dev server (default: http://127.0.0.1:5173)
ALLOWED_ORIGIN=http://127.0.0.1:5173

# ==========================================
# DEV/ADMIN API (Required for Terminal, Sync, Deploy)
# ==========================================
# Generate a secure random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEV_API_TOKEN=your-secure-random-token-here

# Client-visible copy for Vite (only VITE_* variables reach the browser).
# Keep this equal to DEV_API_TOKEN for local development.
VITE_DEV_API_TOKEN=your-secure-random-token-here
VITE_ENABLE_DEV_PAGE=true

# Enable dev endpoints (default: false)
ENABLE_DEV_PAGE=true

# ==========================================
# RATE LIMITS (Optional)
# ==========================================
# Dev API rate limit window in ms (default: 60000)
# DEV_RATE_LIMIT_WINDOW_MS=60000

# Dev API max requests per window (default: 10)
# DEV_RATE_LIMIT_MAX_REQUESTS=10

# ==========================================
# FILE OPERATIONS (Optional)
# ==========================================
# Max upload size in bytes (default: 52428800 = 50MB)
# MAX_UPLOAD_SIZE=52428800

# Enable file watcher for live updates (default: true)
# ENABLE_FILE_WATCHER=true

# ==========================================
# GITHUB DEPLOY (Required for push)
# ==========================================
# Fine-grained or classic PAT with Contents: Read and write on Website-PERKIM.
# Stored server-side only; never sent to the browser.
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=perkimkualalangat/Website-PERKIM
GITHUB_BRANCH=main
LIVE_URL=https://perkimkualalangat.github.io/Website-PERKIM/
GIT_AUTHOR_NAME=PERKIM Kuala Langat
GIT_AUTHOR_EMAIL=perkimkualalangat@users.noreply.github.com