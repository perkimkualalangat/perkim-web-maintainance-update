# Nvidia Computer Ledger - Environment Configuration
# Copy this file to .env.local and fill in your values

# NVIDIA API Key (REQUIRED)
# Get your key from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Model to use (default: Nemotron 3 Ultra)
# Available: nvidia/nemotron-3-ultra-550b-a55b, nvidia/llama-3.1-nemotron-70b-instruct, etc.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# NVIDIA API Base URL (usually don't change)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Request timeout in milliseconds
NVIDIA_TIMEOUT_MS=180000

# Default max tokens per response
NVIDIA_MAX_TOKENS=2048

# Server port (default: 5174)
PORT=5174

# Server host (default: 127.0.0.1)
HOST=127.0.0.1

# Extra CORS origins, comma-separated (optional)
# Ledger Vite uses 5180 so it can run beside Think Vite on 5173.
# ALLOWED_ORIGIN=http://127.0.0.1:5180

# MCP HTTP uses 3011 so it can run beside Think Express on 3001.
MCP_HTTP_PORT=3011
MCP_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5180,http://127.0.0.1:5180

# ============================================================
# Dev Page (/dev) - Feature flag & security
# ============================================================
# Enable /dev page (default: false for production safety)
# ENABLE_DEV_PAGE=true

# Dev API token for /api/dev/* endpoints (REQUIRED if ENABLE_DEV_PAGE=true)
# Generate with: openssl rand -hex 32
# DEV_API_TOKEN=your-secure-random-token-here
